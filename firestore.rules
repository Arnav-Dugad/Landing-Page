rules_version = '2';

// ===========================================================================
// Firestore security rules for the portfolio.
//
// Data lives under:  artifacts/{appId}/public/data/{projects|messages|stats|
//                    reactions|reactionVotes|site|meta|shots|media|history}
//
// Two identities exist:
//
//   · anonymous  — every visitor. Enough to read projects, leave a message
//                  and bump the visit counter. Nothing else.
//   · password   — the admin account. The ONLY identity that may create,
//                  edit, reorder or delete projects.
//
// This is the actual security boundary. The interface hiding its edit buttons
// is cosmetic; these rules are what stop somebody writing to the collection
// straight from the console.
//
// SETUP, in this order — doing it the other way round locks you out:
//   1. Firebase console → Authentication → Sign-in method → enable
//      "Email/Password" (leave "Email link" off).
//   2. Authentication → Users → Add user. Use the email in ADMIN_EMAIL below
//      and a long, unique password.
//   3. Confirm you can sign in on the site (footer padlock).
//   4. Only then paste these rules into Firestore Database → Rules → Publish.
//
// If you ever change the admin address, change it in ADMIN_EMAIL and publish
// again — the rules are the source of truth, not the client.
//
// DEPLOY: Firebase console → Firestore Database → Rules → paste → Publish
//         (or `firebase deploy --only firestore:rules`). Editing this file
//         alone does NOT change the live rules.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- CHANGE THIS to the address you created in step 2 ----------------
    function adminEmail() {
      return "arnavrival12@gmail.com";
    }

    function signedIn() {
      return request.auth != null;
    }

    // A password sign-in matching the admin address. Anonymous sessions can
    // never satisfy this, whatever the client claims about itself.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get("firebase", {}).get("sign_in_provider", "") == "password"
        && request.auth.token.get("email", "").lower() == adminEmail();
    }

    // The Cloudflare Worker's own account. It is the only writer for
    // reactions and link status, so visitors can't stuff counts directly —
    // they go through the Worker, which rate-limits and dedupes them.
    function isEdge() {
      return request.auth != null
        && request.auth.token.get("firebase", {}).get("sign_in_provider", "") == "password"
        && request.auth.token.get("email", "").lower() == "edge-worker@arnavdugad.in";
    }

    function isCount(v) {
      return v is int && v >= 0;
    }

    match /artifacts/{appId}/public/data {

      // ---- Projects: world-readable, admin-only writes -------------------
      match /projects/{projectId} {
        allow read: if true;

        // Shape validation still applies to the admin — it catches a bad
        // client build before it corrupts the collection.
        function validProject() {
          return request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 120
            && request.resource.data.desc is string
            && request.resource.data.desc.size() <= 1000
            && request.resource.data.link is string
            && request.resource.data.link.size() <= 2000
            && (!('longDesc' in request.resource.data) || (request.resource.data.longDesc is string && request.resource.data.longDesc.size() <= 5000))
            && (!('status' in request.resource.data) || request.resource.data.status is string)
            && (!('featured' in request.resource.data) || request.resource.data.featured is bool)
            && (!('caseStudy' in request.resource.data) || request.resource.data.caseStudy is bool)
            && (!('repo' in request.resource.data) || (request.resource.data.repo is string && request.resource.data.repo.size() <= 2000))
            && (!('year' in request.resource.data) || (request.resource.data.year is string && request.resource.data.year.size() <= 24))
            && (!('role' in request.resource.data) || (request.resource.data.role is string && request.resource.data.role.size() <= 120))
            && (!('demoVideo' in request.resource.data) || (request.resource.data.demoVideo is string && request.resource.data.demoVideo.size() <= 2000))
            && (!('order' in request.resource.data) || request.resource.data.order is number)
            && (!('problem' in request.resource.data) || (request.resource.data.problem is string && request.resource.data.problem.size() <= 5000))
            && (!('approach' in request.resource.data) || (request.resource.data.approach is string && request.resource.data.approach.size() <= 5000))
            && (!('outcome' in request.resource.data) || (request.resource.data.outcome is string && request.resource.data.outcome.size() <= 5000))
            && (!('highlights' in request.resource.data) || (request.resource.data.highlights is list && request.resource.data.highlights.size() <= 20))
            && (!('challenges' in request.resource.data) || (request.resource.data.challenges is list && request.resource.data.challenges.size() <= 20))
            && (!('metrics' in request.resource.data) || (request.resource.data.metrics is list && request.resource.data.metrics.size() <= 12))
            && (!('gallery' in request.resource.data) || (request.resource.data.gallery is list && request.resource.data.gallery.size() <= 20))
            && (!('galleryAlt' in request.resource.data) || (request.resource.data.galleryAlt is list && request.resource.data.galleryAlt.size() <= 20))
            && (!('searchTerms' in request.resource.data) || (request.resource.data.searchTerms is list && request.resource.data.searchTerms.size() <= 40))
            && (!('previewVideo' in request.resource.data) || (request.resource.data.previewVideo is string && request.resource.data.previewVideo.size() <= 2000))
            && (!('tags' in request.resource.data) || (request.resource.data.tags is list && request.resource.data.tags.size() <= 30))
            // v2: fields the importer fills in (all optional)
            && (!('platforms' in request.resource.data) || (request.resource.data.platforms is list && request.resource.data.platforms.size() <= 8))
            && (!('tagline' in request.resource.data) || (request.resource.data.tagline is string && request.resource.data.tagline.size() <= 200))
            && (!('appIcon' in request.resource.data) || (request.resource.data.appIcon is string && request.resource.data.appIcon.size() <= 2000))
            && (!('cover' in request.resource.data) || (request.resource.data.cover is string && request.resource.data.cover.size() <= 2000))
            && (!('downloads' in request.resource.data) || (request.resource.data.downloads is list && request.resource.data.downloads.size() <= 12))
            && (!('stores' in request.resource.data) || (request.resource.data.stores is map && request.resource.data.stores.size() <= 10))
            && (!('version' in request.resource.data) || (request.resource.data.version is string && request.resource.data.version.size() <= 40))
            && (!('releasedAt' in request.resource.data) || request.resource.data.releasedAt is number || request.resource.data.releasedAt == null)
            && (!('sources' in request.resource.data) || (request.resource.data.sources is list && request.resource.data.sources.size() <= 10))
            && (!('auto' in request.resource.data) || request.resource.data.auto is bool)
            && (!('locked' in request.resource.data) || (request.resource.data.locked is list && request.resource.data.locked.size() <= 60))
            // v3: build-file facts, dark cover, and hide-without-deleting
            && (!('requirements' in request.resource.data) || (request.resource.data.requirements is list && request.resource.data.requirements.size() <= 6))
            && (!('stack' in request.resource.data) || request.resource.data.stack is map)
            && (!('coverDark' in request.resource.data) || (request.resource.data.coverDark is string && request.resource.data.coverDark.size() <= 2000))
            && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool);
        }

        allow create: if isAdmin() && validProject();

        // The editor saves with setDoc (a full overwrite, not a merge), so an
        // update carries the same shape as a create. Drag-to-reorder instead
        // writes only `order`, which must stay permitted.
        allow update: if isAdmin() && (
          validProject()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['order'])
        );

        allow delete: if isAdmin();
      }

      // ---- Contact messages: write-only from the app, never public ------
      match /messages/{messageId} {
        allow read: if isAdmin();          // read your own inbox when signed in
        allow create: if signedIn()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 200
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 5000;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // ---- Reactions: public counts, written only by the Worker ----------
      match /reactions/{slug} {
        allow read: if true;
        allow write: if isEdge()
          && request.resource.data.keys().hasOnly(['fire', 'clap', 'mind', 'heart', 'idea'])
          && (!('fire' in request.resource.data) || isCount(request.resource.data.fire))
          && (!('clap' in request.resource.data) || isCount(request.resource.data.clap))
          && (!('mind' in request.resource.data) || isCount(request.resource.data.mind))
          && (!('heart' in request.resource.data) || isCount(request.resource.data.heart))
          && (!('idea' in request.resource.data) || isCount(request.resource.data.idea));
      }

      // One doc per (project, emoji, hashed visitor). Never public — the
      // hash is derived from an IP, and even hashed that isn't anyone's
      // business but the Worker's.
      match /reactionVotes/{voteId} {
        allow read, write: if isEdge();
      }

      // ---- Site documents ---------------------------------------------
      // now    — the /now page, written by the admin
      // status — live-link check results, written by the Worker's cron
      match /site/now {
        allow read: if true;
        allow write: if isAdmin()
          && request.resource.data.keys().hasOnly(['building', 'reading', 'learning', 'note', 'updatedAt'])
          && request.resource.data.building is string && request.resource.data.building.size() <= 2000
          && request.resource.data.reading is string && request.resource.data.reading.size() <= 2000
          && request.resource.data.learning is string && request.resource.data.learning.size() <= 2000
          && request.resource.data.note is string && request.resource.data.note.size() <= 2000;
      }
      match /site/status {
        allow read: if true;
        allow write: if isEdge();
      }

      // ---- Living metrics + screenshots, maintained by the Worker --------
      // meta/{projectId}   stars, downloads, versions, Lighthouse, uptime
      // shots/{projectId}  a JPEG of the live site (base64), re-taken
      //                    about once a fortnight
      match /meta/{projectId} {
        allow read: if true;
        allow write: if isEdge();
      }
      match /shots/{shotId} {
        allow read: if true;
        allow write: if isEdge();
      }

      // ---- Uploaded images ----------------------------------------------
      // media/{id} — an image the admin dropped into the editor, compressed
      // in the browser and stored as base64. The id is the start of the
      // image's SHA-256, so documents are write-once: no updates, ever.
      // Served to visitors by the Worker (/api/media/<id>) with an
      // immutable cache, so each is read about once per data centre.
      match /media/{mediaId} {
        allow read: if true;
        allow create: if isAdmin()
          && mediaId.matches('^[a-f0-9]{24}$')
          && request.resource.data.keys().hasOnly(['data', 'type', 'w', 'h', 'bytes', 'name', 'createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0
          && request.resource.data.data.size() <= 1000000
          && request.resource.data.type in ['image/webp', 'image/jpeg', 'image/png']
          && (!('w' in request.resource.data) || (request.resource.data.w is int && request.resource.data.w > 0 && request.resource.data.w <= 4096))
          && (!('h' in request.resource.data) || (request.resource.data.h is int && request.resource.data.h > 0 && request.resource.data.h <= 4096))
          && (!('bytes' in request.resource.data) || request.resource.data.bytes is int)
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 200))
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is number);
        allow update: if false;
        allow delete: if isAdmin();
      }

      // ---- What changed, when ------------------------------------------
      // history/{autoId} — import/edit entries from the admin's browser,
      // refresh/release/rehost entries from the Worker. Private to both.
      match /history/{entryId} {
        allow read: if isAdmin() || isEdge();
        allow create: if (isAdmin() || isEdge())
          && request.resource.data.keys().hasOnly(['projectId', 'at', 'kind', 'summary', 'changes', 'by'])
          && request.resource.data.projectId is string && request.resource.data.projectId.size() <= 128
          && request.resource.data.at is number
          && request.resource.data.kind in ['import', 'refresh', 'edit', 'rehost', 'release']
          && request.resource.data.summary is string && request.resource.data.summary.size() <= 200
          && request.resource.data.changes is list && request.resource.data.changes.size() <= 20
          && request.resource.data.by in ['admin', 'worker'];
        allow update: if false;
        allow delete: if isAdmin();
      }

      // ---- Stats: public read, only the visit counter may change --------
      match /stats/{docId} {
        allow read: if true;
        allow write: if signedIn()
          && request.resource.data.keys().hasOnly(['visitCount'])
          && request.resource.data.visitCount is int;
      }
    }
  }
}
