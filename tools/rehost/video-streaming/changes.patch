 /** @type {import('next').NextConfig} */
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+
+// Rehost on Cloudflare Workers: Firestore's Node build pulls in protobufjs,
+// which generates code at runtime (forbidden on Workers). The browser build
+// talks plain HTTPS instead.
+const firestoreBrowser = require.resolve('@firebase/firestore').replace(/index\.node\.cjs\.js$/, 'index.esm.js');
+
 const nextConfig = {
+  webpack(config, { isServer }) {
+    if (isServer) {
+      config.resolve.alias = { ...(config.resolve.alias || {}), '@firebase/firestore$': firestoreBrowser };
+    }
+    return config;
+  },
   reactStrictMode: true,
   images: {
     // YouTube serves thumbnails and avatars from these hosts.
