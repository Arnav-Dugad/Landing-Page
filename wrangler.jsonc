{
    // Cloudflare Workers + static assets. The repo root *is* the site; files
    // that aren't part of it are listed in .assetsignore.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "arnav-portfolio",
    "main": "worker/index.js",
    "compatibility_date": "2026-09-01",
    "assets": {
        "directory": ".",
        "binding": "ASSETS",
        // /case serves case.html, like Vercel's cleanUrls.
        "html_handling": "auto-trailing-slash",
        // Unknown paths get /404.html with a real 404 status.
        "not_found_handling": "404-page",
        // Only these paths wake the worker; everything else is a static hit.
        "run_worker_first": ["/api/*", "/p/*", "/sitemap.xml", "/feed.xml", "/feed.json", "/_vercel/*"]
    },

    // Public, non-secret settings. Secrets (never in this file):
    //   EDGE_EMAIL, EDGE_PASSWORD     the worker's own Firebase account
    //   ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY   admin AI tools
    //   VOTER_SALT (optional)
    //   GITHUB_TOKEN (fine-grained, public read-only — 5,000 GitHub requests
    //                 an hour instead of 60, and the contribution calendar)
    //   PSI_API_KEY  (optional Google API key for PageSpeed Insights quota)
    // Set with `npx wrangler secret put NAME`, or locally in .dev.vars.
    "vars": {
        "ADMIN_EMAIL": "arnavrival12@gmail.com",
        "GITHUB_USER": "Arnav-Dugad"
    },

    // Cloudflare Browser Rendering — headless Chrome for /api/shot. The
    // captures themselves are stored in Firestore, not on Cloudflare.
    "browser": { "binding": "BROWSER" },

    // No cron: the account's 5 free cron slots are used by other Workers.
    // /api/status re-checks on demand whenever the stored result is older
    // than 15 minutes, so a visit is what keeps it fresh.
    "triggers": { "crons": [] },

    // arnavdugad.in is on Cloudflare's nameservers; deploying attaches both
    // hostnames to this worker (DNS records + certificates are automatic).
    // Keep the workers.dev address alive as a backup / preview URL.
    "workers_dev": true,
    "routes": [
        { "pattern": "www.arnavdugad.in", "custom_domain": true },
        { "pattern": "arnavdugad.in", "custom_domain": true }
    ],

    "observability": { "enabled": true }
}
